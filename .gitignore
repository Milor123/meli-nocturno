# ---- personal / not for publication ---------------------------------------
# Screenshots of a logged-in account: contain real name, delivery address and
# order history. Never commit these.
shots/
*.png
*.jpeg
*.jpg

# Reference UserCSS written by other authors. Kept locally for palette
# measurement only; redistributing them is a licensing problem.
references/

# Working notes: measurement logs with personal purchase data and prices.
NOTAS-*.md
PLAN-*.md

# README screenshots: redacted, safe to publish
!docs/images/*.jpeg
!docs/images/*.png

# ---- dev helpers and internal tracking ------------------------------------
# Screenshot redaction helper: one-off, not part of the theme.
dist/redact.js
# ODD feature tracking, same category as the working notes above.
odd/

# ---- build debris ---------------------------------------------------------
# Debug bundles generated by the verification loop (embed the whole stylesheet
# plus a probe). They are not part of the theme.
dist/test-*.js
dist/_inner.css
